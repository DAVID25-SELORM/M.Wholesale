# ---------------------------------------------------------------------------
# Browser (Vite) variables. Everything prefixed VITE_ is PUBLIC - it ships to the browser.
# Only the project URL and the *anon / publishable* key belong here.
# NEVER put a service-role key in a VITE_ variable.
#
# Local development: `npm run stack:up` writes a working .env.local for you
# (URL = the Vite dev server, which proxies /auth/v1 and /rest/v1 to the local stack).
# Hosted: use your Supabase project URL and anon key.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# ---------------------------------------------------------------------------
# Server-side / scripts only (never exposed to the browser, never committed):
#
# DEV_SEED_PASSWORD   password given to the demo users by `npm run seed:dev`
#                     (required, >= 12 characters, intentionally has no default).
#                     Pass it inline:  DEV_SEED_PASSWORD='...' npm run seed:dev
#
# The service-role key is NOT configured here. For the local stack it is generated into
# .stack/secrets.json (git-ignored); for a real project keep it in your server / CI secret store.
#
# Optional overrides for the throwaway database used by `npm run test:db`:
# WPS_TEST_PORT=54522
# WPS_TEST_PASSWORD=
# WPS_TEST_CONTAINER=wps-phase0-testdb
# ---------------------------------------------------------------------------
